PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

FAL_KEY=coloque_sua_chave_aqui

# usado pelo falVton.service.js para montar URLs públicas das fotos das peças
BACKEND_BASE_URL=http://localhost:3001

# Endereços da ESP32-CAM (firmware em firmware/esp32-cam).
# O IP aparece no monitor serial: npm run cam:monitor
ESP32_CAPTURE_URL=http://192.168.0.50/capture
ESP32_STREAM_URL=http://192.168.0.50:81/stream
